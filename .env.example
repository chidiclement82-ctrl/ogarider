# Copy this file to .env.local and fill in the values.

# Paystack secret key (Paystack dashboard > Settings > API Keys & Webhooks).
# Use the sk_test_... key while testing and sk_live_... when you go live.
# Without it, development shows a payment simulator instead of Paystack.
PAYSTACK_SECRET_KEY=

# Public address of the app, used for the payment return link, e.g. https://ogarider.com
APP_URL=http://localhost:3000

# Admin account. Applied every time the app starts: changing ADMIN_PASSWORD and
# restarting resets that admin's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the database and uploaded pictures are stored. On a server, set this to a
# persistent disk (e.g. /data); leave empty on your own computer.
DATA_DIR=
